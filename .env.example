HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
TMP_DIR=tmp
JOB_TTL_SEC=1800
COOKIES_PATH=cookies.txt
MAX_FRAMES=900
FRAME_STRIDE=1
FRAMES_PAGE_MAX=60
# 미리보기/URL 캐시 유효시간(초). 본 잡도 같은 캐시를 재사용해 다운로드 1회로 충분.
PREVIEW_TTL_SEC=3600
# 옵티컬 플로우 보간: 1=검출 실패 프레임을 흐름으로 메움(기본), 0=끄기
FLOW_FILL=1
FLOW_WIDTH=256
# 실루엣 마스크: 1=루트 안정화에 사용(기본, 추가 의존성 없음), 0=끄기
SILHOUETTE_ENABLED=1
# MiDaS 뎁스: 1=루트 z에 사용(기본, torch 없으면 자동 스킵), 0=끄기
DEPTH_ENABLED=1
# 손가락 미세굽힘 deadzone(정규화 각도). 이하 노이즈는 0 처리. 기본 ~8도.
FINGER_DEADZONE=0.045
# 발/발가락 미세각도 deadzone(라디안). 기본 ~4.6도.
TOE_DEADZONE=0.08
# 프레임당 최대 관절 회전 변화량(rad). 노이즈 스파이크 차단. 30fps 기준 0.45=초당 ~13.5rad까지 허용.
FK_MAX_STEP=0.45
# SMPL 정제 (Colab HMR2로 뽑은 slim pkl): 비어있으면 스킵. 있으면 팔다리+목머리+쇄골+손목을 FK에 이식.
# 몸통·발·손가락·루트·지면은 기존 스택 유지. SMPL_SUBJ=auto(최장 트랙)|번호.
SMPL_PKL=
SMPL_SUBJ=auto
# SMPL 자동화 (HF Spaces GPU 워커, 무료 ZeroGPU): 1이면 extract 뒤 워커 호출.
# 수동 SMPL_PKL이 있으면 그게 우선. 실패·타임아웃 시 FK 그대로 진행.
SMPL_AUTO=0
HF_SPACE=
HF_TOKEN=
SMPL_TIMEOUT=600
# 관절 가동범위 전체 배율. 비정상 꺾임이 남으면 0.8, 유연한 춤이면 1.2.
JOINT_LIMIT_SCALE=1.0
# 유튜브 포맷: 비우면 720p progressive mp4 (merge 불필요). 고화질 원하면 예:
# YTDL_FORMAT=bestvideo[vcodec^=avc1]+bestaudio[acodec^=mp4a]/best
YTDL_FORMAT=
YTDL_MAX_HEIGHT=720
# PO Token 스크립트용 bgutil 서버 소스 경로 (Docker 이미지에 번들됨)
BGUTIL_SERVER_HOME=/srv/bgutil-ytdlp-pot-provider/server
# 로컬 개발 리로더: 1이면 uvicorn reload (Render에선 반드시 비워둘 것)
UVICORN_RELOAD=
# 손가락: 1=추출(기본), 0=끄기. HAND_MODEL_PATH 지정시 해당 파일 사용.
ENABLE_HANDS=1
MAX_HANDS=2
HAND_MODEL_PATH=
# 루트모션: 정규화 이동→아바타 단위 배율 (기본 2.0)
ROOT_K=2.0
# 대상 지정: 다인 검출 수(위치/얼굴 지정시에만 사용), 추적 게이트/허용 공백프레임
MAX_POSES=4
TRACK_GATE=0.25
TRACK_GAP_TOL=15
# 얼굴 매칭 임계(코사인, 기본 0.4). 미달시 중앙 사람으로 폴백.
FACE_THRESHOLD=0.4
# 참고용 AI 춤 영상 (아바타 옆 대조용, 결과물 아님):
# mock(기본 자리표시자) | replicate(MimicMotion API) | local(자체 GPU 안내)
GENVIDEO_BACKEND=mock
REPLICATE_API_TOKEN=
# 원본 음원: 1=추출(기본), 0=끄기. ffmpeg는 imageio-ffmpeg로 자동 해결.
AUDIO_ENABLED=1
AUDIO_BITRATE=128k
GENVIDEO_MODEL=zsxkib/mimic-motion
GENVIDEO_INPUT_IMAGE_KEY=ref_image
GENVIDEO_INPUT_VIDEO_KEY=ref_video
# 모션 소스: original(원본 영상, 권장) | control(스켈레톤 영상)
GENVIDEO_MOTION_SOURCE=original
# 1) 저장소: auto|memory|redis|postgres|hybrid
STORE_BACKEND=auto
REDIS_URL=
DATABASE_URL=
# 2) 보안: 비어있으면 개발모드(인증 우회). 운영에선 API_KEYS 필수.
API_KEYS=
API_KEY_FILE=
RATE_LIMIT_CREATE_PER_MIN=20
RATE_LIMIT_READ_PER_MIN=300
# 쿠키 시크릿: COOKIES_B64 > COOKIES_SECRET_FILE > COOKIES_PATH 순
COOKIES_B64=
COOKIES_SECRET_FILE=/run/secrets/youtube_cookies
# 3) S3 공유 Blob: 비어있으면 로컬 tmp
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=motions/
AWS_REGION=
